import machine
import time

# Set up I2C communication (adjust the pins for your microcontroller)
i2c = machine.I2C(0, scl=machine.Pin(1), sda=machine.Pin(0), freq=100000)

# VL6180 default I2C address
VL6180_ADDR = 0x29
PART_ID_REGISTER = 0x010F  # Register to check for sensor communication

# Function to scan I2C bus and print all connected devices
def scan_i2c_devices():
    """Scan for I2C devices and print their addresses."""
    devices = i2c.scan()
    if devices:
        print("I2C devices found:", [hex(device) for device in devices])
    else:
        print("No I2C devices found.")
    return devices

# Function to read the part ID register from the VL6180 sensor
def read_part_id():
    """Read the Part ID register to check if the sensor is connected."""
    try:
        part_id = i2c.readfrom_mem(VL6180_ADDR, PART_ID_REGISTER, 1)
        print(f"VL6180 Part ID: {hex(part_id[0])}")
    except Exception as e:
        print(f"Error reading Part ID: {e}")
        # More detailed error information
        if e.args[0] == 5:  # EIO error code
            print("I/O Error: Likely caused by incorrect wiring or the sensor not being responsive.")
        else:
            print(f"Unexpected error: {e}")

# Main function to check I2C communication and VL6180 sensor connection
def main():
    print("Starting I2C communication...")

    # Scan I2C bus for connected devices
    devices = scan_i2c_devices()
    
    # Check if the VL6180 sensor is found on the bus
    if VL6180_ADDR in devices:
        print(f"VL6180 sensor found at address {hex(VL6180_ADDR)}")
        
        # Try reading the Part ID register to confirm sensor communication
        read_part_id()
        
    else:
        print(f"No VL6180 sensor found at address {hex(VL6180_ADDR)}. Please check your wiring.")
        
        # Try scanning for other addresses (if VL6180 is using a different address)
        print("Attempting to find I2C devices on different addresses...")
        for addr in range(0x03, 0x78):
            if addr in devices:
                print(f"Device found at address {hex(addr)}")
        
        print("Please check your wiring and ensure the sensor is powered properly.")

# Run the main function
main()

