import ustruct
import time
import machine

class Sensor:
    def __init__(self, i2c, address=0x29):
        self.i2c = i2c
        self._address = address
        self.init()
        self.default_settings()

    def _set_reg8(self, address, value):
        data = ustruct.pack('>BH', address, value)
        self.i2c.writeto(self._address, data)

    def _set_reg16(self, address, value):
        data = ustruct.pack('>HH', address, value)
        self.i2c.writeto(self._address, data)

    def _get_reg8(self, address):
        self.i2c.writeto(self._address, bytes([address]))
        data = self.i2c.readfrom(self._address, 1)
        return data[0]

    def _get_reg16(self, address):
        self.i2c.writeto(self._address, bytes([address]))
        data = self.i2c.readfrom(self._address, 2)
        return ustruct.unpack('>H', data)[0]

    def init(self):
        time.sleep(0.1)  # Delay to ensure sensor is powered up and stable

        # Check if the sensor is communicating by reading the model register (0x0000)
        try:
            model = self._get_reg8(0x0000)
            print(f"Sensor model: {model}")
        except Exception as e:
            raise RuntimeError(f"Error reading sensor model: {e}")

        # Perform reset check
        if self._get_reg8(0x0016) != 1:
            raise RuntimeError("Failure reset")

        # Recommended setup from the datasheet
        self._set_reg8(0x0207, 0x01)
        self._set_reg8(0x0208, 0x01)
        self._set_reg8(0x0096, 0x00)
        self._set_reg8(0x0097, 0xfd)
        self._set_reg8(0x00e3, 0x00)
        self._set_reg8(0x00e4, 0x04)
        self._set_reg8(0x00e5, 0x02)
        self._set_reg8(0x00e6, 0x01)
        self._set_reg8(0x00e7, 0x03)
        self._set_reg8(0x00f5, 0x02)
        self._set_reg8(0x00d9, 0x05)
        self._set_reg8(0x00db, 0xce)
        self._set_reg8(0x00dc, 0x03)
        self._set_reg8(0x00dd, 0xf8)
        self._set_reg8(0x009f, 0x00)
        self._set_reg8(0x00a3, 0x3c)
        self._set_reg8(0x00b7, 0x00)
        self._set_reg8(0x00bb, 0x3c)
        self._set_reg8(0x00b2, 0x09)
        self._set_reg8(0x00ca, 0x09)
        self._set_reg8(0x0198, 0x01)
        self._set_reg8(0x01b0, 0x17)
        self._set_reg8(0x01ad, 0x00)
        self._set_reg8(0x00ff, 0x05)
        self._set_reg8(0x0100, 0x05)
        self._set_reg8(0x0199, 0x05)
        self._set_reg8(0x01a6, 0x1b)
        self._set_reg8(0x01ac, 0x3e)
        self._set_reg8(0x01a7, 0x1f)
        self._set_reg8(0x0030, 0x00)

    def default_settings(self):
        self._set_reg8(0x010A, 0x30)  # Set Avg sample period
        self._set_reg8(0x003f, 0x46)  # Set the ALS gain
        self._set_reg8(0x0031, 0xFF)  # Set auto calibration period
        self._set_reg8(0x0040, 0x63)  # Set ALS integration time to 100ms
        self._set_reg8(0x002E, 0x01)  # Perform a single temperature calibration

    def range(self):
        """Measure the distance in millimeters."""
        # Trigger measurement by writing to SYSRANGE_START register (0x0018)
        self._set_reg8(0x0018, 0x01)  # Start measurement

        # Wait until the measurement is complete
        while True:
            status = self._get_reg8(0x004d)  # Read the status register
            if status & 0x01:  # Check if the measurement is complete (measurement ready flag)
                break
            time.sleep(0.01)  # Wait before checking the status again

        # Read the range result (register 0x0062), which is a 16-bit result (2 bytes)
        distance = self._get_reg16(0x0062)  # Read 2 bytes for distance

        # Debug output: read the sensor's status register to check for any issues
        sensor_status = self._get_reg8(0x004d)
        print(f"Sensor status register: {sensor_status}")

        print(f"Raw distance result (0x0062): {distance}")  # Debug print for raw value
        return distance


# I2C configuration (SDA pin 0, SCL pin 1)
SDA_PIN = 0       # I2C SDA pin (GP0)
SCL_PIN = 1       # I2C SCL pin (GP1)
i2c = machine.I2C(0, sda=machine.Pin(SDA_PIN), scl=machine.Pin(SCL_PIN), freq=100000)

# I2C scan to detect connected devices
def scan_i2c(i2c):
    devices = i2c.scan()
    if devices:
        print("I2C devices found:", devices)
    else:
        print("No I2C devices found")

# Scan the I2C bus
scan_i2c(i2c)

# Instantiate the Sensor class
sensor = Sensor(i2c)

# Main loop to read and print distance
while True:
    try:
        # Trigger a measurement and get the distance
        distance = sensor.range()
        print(f"Measured Distance: {distance} mm")  # Print the measured distance in mm

    except Exception as e:
        print("I2C error:", e)

    time.sleep(1)  # Delay before the next reading

