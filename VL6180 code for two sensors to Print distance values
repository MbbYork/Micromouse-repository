SDA_PIN_1 = 2
SCL_PIN_1 = 3

# Set up I2C on GP0 (SDA) and GP1 (SCL) with a frequency of 50kHz
i2c_0 = machine.I2C(0, sda=machine.Pin(SDA_PIN_0), scl=machine.Pin(SCL_PIN_0), freq=50000)
i2c_1 = machine.I2C(1, sda=machine.Pin(SDA_PIN_1), scl=machine.Pin(SCL_PIN_1), freq=50000)

# Initialize the two sensors with different addresses
sensor1 = Sensor(i2c_0)
sensor2 = Sensor(i2c_1)

# Main loop to read and print distance for both sensors
def sensordata1:
while True:
