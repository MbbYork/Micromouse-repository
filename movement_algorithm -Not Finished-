
class Maze:
    def __init__(self, height, width):
        self.height = height
        self.width = width
        self.grid = [[0 for _ in range(width)] for _ in range(height)]
    
    def first_walls(self, x, y, north=True, east=False, south=False, west=True):

         # Take sensor input
        try:
            frnt_snsr = int(input('front sensor (0 or 1):  '))
            lft_snsr = int(input('right sensor (0 or 1):  '))
        except ValueError:
            print('Invalid input. Defaulting to NO walls.')
            frnt_snsr = lft_snsr = 0
        

        east = bool(lft_snsr)
        south = bool(frnt_snsr)
        
        self.grid[y][x] = (north << 3) | (east << 2) | (south << 1) | west

        
    
    #Determine the placement of the walls in each cell, x and y are the coordinates of the cell, w for the orientation of the robot.
    def walls(self, x, y, orientation, north=False, east=False, south=False, west=False):
        # Override south if specified
        #south = south_override if south_override is not None else south
        
        # Take sensor input
        try:
            frnt_snsr = int(input('front sensor (0 or 1):  '))
            rght_snsr = int(input('right sensor (0 or 1):  '))
            lft_snsr = int(input('left sensor (0 or 1):  '))
        except ValueError:
            print('Invalid input. Defaulting to NO walls.')
            frnt_snsr = rght_snsr = lft_snsr = 0
        
        #determining the sensors according to the orientation. u : Up. d : down. r : right. l : left.
        if orientation == "u":
            # Convert to boolean values for walls
            north = bool(frnt_snsr)
            east = bool(rght_snsr)
            west = bool(lft_snsr)
            south = False
            
        elif orientation == "d":
            north = False
            east = bool(lft_snsr)
            west = bool(rght_snsr)
            south = bool(frnt_snsr)
            
        elif orientation == "r":
            north = bool(lft_snsr)
            east = bool(frnt_snsr)
            west = False
            south = bool(rght_snsr)
            
        elif orientation == "l":
            north = bool(rght_snsr)
            east = False
            west = bool(frnt_snsr)
            south = bool(lft_snsr)

        else:
            print("Invalid input. No walls set.")
            
        #Encode wall data into the grid
        self.grid[y][x] = (north << 3) | (east << 2) | (south << 1) | west

    def display(self):
        for row in self.grid:
            print(row)


    def cell_up(self, x, y):
        if y > 0:
            return (x, y - 1)
        print("Reached the top boundary. Cannot move up.")
        return (x, y)
    
    def cell_down(self, x, y):
        if y < self.height - 1:
            return (x, y + 1)
        print("Reached the bottom boundary. Cannot move down.")
        return (x, y)

    def cell_right(self, x, y):
        if x < self.width - 1:
            return (x + 1, y)
        print("Reached the right boundary. Cannot move right.")
        return (x, y)

    def cell_left(self, x, y):
        if x > 0:
            return (x - 1, y)
        print("Reached the left boundary. Cannot move left.")
        return (x, y)
    
    def move_forward(self, x, y, orientation):
        if orientation == "u":
            new_cell = self.cell_up(x, y)
        elif orientation == "d":
            new_cell = self.cell_down(x, y)
        elif orientation == "r":
            new_cell = self.cell_right(x, y)
        elif orientation == "l":
            new_cell = self.cell_left(x, y)
        else:
            raise ValueError("Invalid Orientation" + orientation)
        
        return new_cell
    

# Initialize the maze
maze = Maze(5, 5)

maze.first_walls(0, 0)

current_cell = (0, 0)

# Display the grid
maze.display()

#repeat forever
while True:
            
    D = input("Enter the direction (u, d, l, r): ").strip().lower()

    new_cell = maze.move_forward(current_cell[0], current_cell[1], D)

    #If no movement occurs, stop the loop
    if new_cell == current_cell:
        print("Transversal Completed.")
        break
    
    #Process the new cell
    maze.walls(new_cell[0], new_cell[1], D)
    
    # Display the grid after the new cell
    maze.display()
    
    #Update the current cell
    current_cell = new_cell



