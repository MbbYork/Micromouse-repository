def get_sensors():
    # Take sensor input
    if front_sensor.read() <= 50:
        frnt_snsr = 1
    else:
        frnt_snsr = 0
    if right_sensor.read() <= 50:
        rght_snsr = 1
    else:
        rght_snsr = 0
    if left_sensor.read() <= 50:
        lft_snsr = 1
    else:
        lft_snsr = 0
    return frnt_snsr, rght_snsr, lft_snsr

